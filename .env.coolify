# =====================================================================
# Variáveis de Ambiente para o Coolify (Copie para a aba "Environment Variables" no Coolify)
# =====================================================================

# Porta exposta pelo serviço no container
PORT=8080

# Chave de API opcional (usada se você ativar proxy com X-API-Key)
SCRAPER_API_KEY=sua_chave_secreta_aqui

# Usuário e senha para Basic Auth (se for proteger a nível de aplicação/proxy)
SCRAPER_USER=admin
SCRAPER_PASSWORD=uma_senha_muito_forte_aqui

# Proxies opcionais (caso queira injetar proxies padrão para evitar bloqueios de IP pelo Google)
# Formato: protocolo://usuario:senha@host:porta (separados por vírgula)
# Exemplo: SOCKS5 ou HTTP
# PROXIES=http://user:pass@proxy1.com:8080,socks5://user:pass@proxy2.com:1080
