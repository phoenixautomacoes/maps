# Configuração do Scraper (Local ou Remoto via Coolify)
# Copie para .env: cp .env.example .env

# URL base do scraper (localhost ou a URL do seu Coolify com HTTPS)
SCRAPER_BASE_URL=http://localhost:8080

# Chave de API (usada se você configurou autenticação por X-API-Key no Coolify/Proxy)
SCRAPER_API_KEY=

# Autenticação Básica (se ativou "Basic Auth" nas configurações do Coolify)
SCRAPER_USER=
SCRAPER_PASSWORD=
